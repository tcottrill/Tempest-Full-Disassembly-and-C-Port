# Makefile.mac - macOS (Apple Silicon) build of the Tempest C port.
#   make -f Makefile.mac            build the playable binary build/mac/tempest_mac (needs SDL2)
#   make -f Makefile.mac app        build/mac/Tempest.app (bundles libSDL2)
#   make -f Makefile.mac tools      build gate, passcost, avgshapes, avgframe, avgtime
#   make -f Makefile.mac gate       record the 12 lockstep traces, replay each through gate
#   make -f Makefile.mac passcost   run the pass-cost observer and refit app_loop.c's table
#   make -f Makefile.mac avg        avgtime + avgframe (vs the Python AVG model, if disasm image exists)
#   make -f Makefile.mac gatev      Gate V (avgshapes); needs Atari's source archive, see below
#   make -f Makefile.mac check      headless: skeleton + self-test + lockstep
#   make -f Makefile.mac skeleton   build + run the boot/loop smoke test
#   make -f Makefile.mac selftest   build + run the headless seam self-test
#   make -f Makefile.mac lockstep   build + run the lockstep verifier (C vs ROM)
# Mirrors build_all.bat.  The core is built unchanged; flags only.
# Needs: Xcode Command Line Tools.  (SDL2 is only needed for the window backend.)
CC     ?= clang
OUT    := build/mac
# the core relies on MSVC pulling NULL in transitively; clang needs it forced (flag only, no core edit)
FLAGS  := -O2 -std=c11 -Wall -Wextra -Wno-unused-parameter -include stddef.h -I.
REF    := tests/ref6502

HW      := mathbox.c mbprom.c progrom.c vecrom.c
GAME    := state.c alexec.c alhar2.c altes2.c aldis2.c alsoun.c alwelg.c alsco2.c alcoin.c allang.c allang_data.c alearo.c alvgut.c
PORTED  := alvgut.c alhar2.c alcoin.c alsoun.c alexec.c alearo.c alsco2.c allang.c allang_data.c aldis2.c alwelg.c altes2.c
CHIPS   := c012294.c er2055.c
SEAM    := avg.c platform/headless/plat_headless.c $(CHIPS)
STMODS  := state.c alexec.c alhar2.c aldis2.c alsoun.c alwelg.c alsco2.c alcoin.c allang.c allang_data.c alearo.c alvgut.c
RESET_HOOKS := -DALTES2_SEAM_HAS_RESET_HOOKS

GEN := state_defs.h progrom.c vecrom.c mbprom.c allang_data.c allang_data.h aldis2_data.h alwelg_data.h altes2_data.h

SDL_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null)
SDL_LIBS   := $(shell sdl2-config --libs 2>/dev/null)

all: $(OUT)/tempest_mac

$(GEN):
	@echo "MISSING $@ - run the generators in tools/"; exit 1

# the playable binary: SDL2 backend + the game.  win_probe.c is read-only peeks at the
# machine state (it only looks like a Windows file; it includes no Windows headers).
$(OUT)/tempest_mac: platform/macos/plat_mac.c platform/windows/win_probe.c app_loop.c $(GAME) $(HW) avg.c $(CHIPS) $(GEN) $(wildcard *.h platform/*.h)
	@mkdir -p $(OUT)
	$(CC) $(FLAGS) $(RESET_HOOKS) $(SDL_CFLAGS) platform/macos/plat_mac.c platform/windows/win_probe.c app_loop.c $(GAME) $(HW) avg.c $(CHIPS) $(SDL_LIBS) -o $@

$(OUT)/skeleton: app_loop.c $(GAME) $(HW) $(SEAM) $(GEN) $(wildcard *.h platform/*.h)
	@mkdir -p $(OUT)
	$(CC) $(FLAGS) -DTEMPEST_SKELETON_MAIN $(RESET_HOOKS) app_loop.c $(GAME) $(HW) $(SEAM) -o $@

# altes2.c is compiled apart with SYSTEM / DSPSYS renamed so app_loop.c can count them
$(OUT)/selftest_altes2.o: altes2.c
	@mkdir -p $(OUT)
	$(CC) $(FLAGS) $(RESET_HOOKS) -Dsystem_=altes2_system_ -Ddspsys=altes2_dspsys -c altes2.c -o $@

$(OUT)/tempest_selftest: app_loop.c $(STMODS) $(HW) $(SEAM) $(OUT)/selftest_altes2.o $(GEN) $(wildcard *.h platform/*.h)
	$(CC) $(FLAGS) -DTEMPEST_SELFTEST_MAIN app_loop.c $(STMODS) $(HW) $(SEAM) $(OUT)/selftest_altes2.o -o $@

# the oracle and verifier are foreign/verbatim code: build with -w like build_all.bat's /W3
$(OUT)/lockstep: tests/refrun.c tests/lockstep.c $(REF)/ref6502.c $(PORTED) state.c $(HW) er2055.c $(GEN)
	@mkdir -p $(OUT)
	$(CC) -O2 -std=c11 -w -include stddef.h -I. -I$(REF) -DLOCKSTEP $(RESET_HOOKS) tests/refrun.c tests/lockstep.c state.c $(PORTED) $(HW) $(REF)/ref6502.c er2055.c -o $@

# ---- gate: the C modules alone, replayed on a lockstep trace ------------------------------
# /DLOCKSTEP only turns the modules' CK() checkpoints into lk_ck() calls (defined in tests/gate.c);
# SYSTEM / DSPSYS are renamed so gate.c can count them.
$(OUT)/gate_altes2.o: altes2.c
	@mkdir -p $(OUT)
	$(CC) $(FLAGS) -DLOCKSTEP $(RESET_HOOKS) -Dsystem_=altes2_system_ -Ddspsys=altes2_dspsys -c altes2.c -o $@

$(OUT)/gate: tests/gate.c $(STMODS) $(HW) $(OUT)/gate_altes2.o $(GEN) $(wildcard *.h)
	$(CC) $(FLAGS) -DLOCKSTEP tests/gate.c $(STMODS) $(HW) $(OUT)/gate_altes2.o -o $@

# ---- passcost: refrun as a per-pass CPU-cost observer (app_loop.c's pass-cost fit) ----------
$(OUT)/passcost: tests/refrun.c $(REF)/ref6502.c $(HW) er2055.c $(GEN)
	@mkdir -p $(OUT)
	$(CC) -O2 -std=c11 -w -include stddef.h -I. -I$(REF) -DPASSCOST tests/refrun.c $(HW) $(REF)/ref6502.c er2055.c -o $@

# ---- AVG walker tools (Gate V and the frame / draw-time checks) -----------------------------
AVGSRC := avg.c state.c progrom.c vecrom.c
$(OUT)/avgshapes $(OUT)/avgframe $(OUT)/avgtime: $(OUT)/%: tests/%.c $(AVGSRC) $(GEN) $(wildcard *.h)
	@mkdir -p $(OUT)
	$(CC) $(FLAGS) tests/$*.c $(AVGSRC) -o $@

tools: $(OUT)/gate $(OUT)/passcost $(OUT)/avgshapes $(OUT)/avgframe $(OUT)/avgtime

skeleton: $(OUT)/skeleton
	$(OUT)/skeleton 100

# app_loop.c's self-test opens literal Windows paths ("tests\\scenarios\\selftest_boot.txt",
# "tests\\ref\\frame_0001.ram", "tests\\ref_selftest\\frame_NNNN.*").  On macOS a backslash is a
# filename character, so run from a scratch dir of symlinks with those exact names.  No core change.
# The oracle dumps are not checked in; they are generated here by the real ROM run (lockstep = refrun
# + verifier): tests\ref = 300 frames of attract, tests\ref_selftest = selftest_boot.txt, 1800 frames.
$(OUT)/refdumps/.stamp: $(OUT)/lockstep tests/scenarios/selftest_boot.txt
	rm -rf $(OUT)/refdumps && mkdir -p $(OUT)/refdumps/ref $(OUT)/refdumps/selftest
	$(OUT)/lockstep --frames 600 --outdir $(OUT)/refdumps/ref > $(OUT)/refdumps/ref.log
	$(OUT)/lockstep --frames 1800 --script tests/scenarios/selftest_boot.txt --outdir $(OUT)/refdumps/selftest > $(OUT)/refdumps/selftest.log
	@touch $@

selftest: $(OUT)/tempest_selftest $(OUT)/refdumps/.stamp
	@rm -rf $(OUT)/run && mkdir -p $(OUT)/run
	@ln -s ../../../tests/scenarios/selftest_boot.txt '$(OUT)/run/tests\scenarios\selftest_boot.txt'
	@for f in $(OUT)/refdumps/ref/frame_*; do ln -s ../refdumps/ref/$$(basename $$f) "$(OUT)/run/tests\\ref\\$$(basename $$f)"; done
	@for f in $(OUT)/refdumps/selftest/frame_*; do ln -s ../refdumps/selftest/$$(basename $$f) "$(OUT)/run/tests\\ref_selftest\\$$(basename $$f)"; done
	cd $(OUT)/run && ../tempest_selftest

# the twelve lockstep runs (ten scripted scenarios + two unscripted attract runs).  Self-test / EAROM: frames and options from tests/scenarios/README_selftest.md;
# gameplay: frames from record_refs.bat.
# earom writes the image that earom_readback reads; it goes under build/ (tests/earom/ does not exist).
lockstep: $(OUT)/lockstep
	mkdir -p $(OUT)/earom
	$(OUT)/lockstep --frames 1800 --no-dumps --script tests/scenarios/selftest_boot.txt
	$(OUT)/lockstep --frames 2500 --no-dumps --script tests/scenarios/selftest_midrun.txt
	$(OUT)/lockstep --frames 2600 --no-dumps --script tests/scenarios/earom.txt --earom-out $(OUT)/earom/earom.nv
	$(OUT)/lockstep --frames 600 --no-dumps --script tests/scenarios/earom_readback.txt --earom-in $(OUT)/earom/earom.nv --earom-out $(OUT)/earom/readback_out.nv
	cmp $(OUT)/earom/earom.nv $(OUT)/earom/readback_out.nv
	$(OUT)/lockstep --frames 3000 --no-dumps --script tests/scenarios/coin_start.txt
	$(OUT)/lockstep --frames 3000 --no-dumps --script tests/scenarios/high_score.txt
	$(OUT)/lockstep --frames 3000 --no-dumps --script tests/scenarios/two_player.txt
	$(OUT)/lockstep --frames 3000 --no-dumps --script tests/scenarios/superzapper.txt
	$(OUT)/lockstep --frames 4000 --no-dumps --script tests/scenarios/fuseball_pulsar.txt
	$(OUT)/lockstep --frames 1500 --no-dumps --script tests/scenarios/slam.txt
	$(OUT)/lockstep --frames 600 --no-dumps
	$(OUT)/lockstep --frames 5000 --no-dumps

# ---- gate: record the 12 lockstep traces (record_refs.bat), replay each through gate.exe ----
# earom_2600 writes the image earom_readback_600 boots from: keep the order.
gate: $(OUT)/gate $(OUT)/lockstep $(OUT)/refdumps/.stamp
	@set -e; G=$(OUT)/gate_traces; SC=tests/scenarios; rm -rf $$G; mkdir -p $$G $(OUT)/earom; \
	rec() { n=$$1; shift; $(OUT)/lockstep --no-dumps "$$@" --trace-out $$G/$$n.trc > $$G/$$n.log; }; \
	rec attract_600 --frames 600; rec attract_5000 --frames 5000; \
	rec coin_start_3000 --frames 3000 --script $$SC/coin_start.txt; \
	rec high_score_3000 --frames 3000 --script $$SC/high_score.txt; \
	rec two_player_3000 --frames 3000 --script $$SC/two_player.txt; \
	rec superzapper_3000 --frames 3000 --script $$SC/superzapper.txt; \
	rec fuseball_pulsar_4000 --frames 4000 --script $$SC/fuseball_pulsar.txt; \
	rec slam_1500 --frames 1500 --script $$SC/slam.txt; \
	rec selftest_boot_1800 --frames 1800 --script $$SC/selftest_boot.txt; \
	rec selftest_midrun_2500 --frames 2500 --script $$SC/selftest_midrun.txt; \
	rec earom_2600 --frames 2600 --script $$SC/earom.txt --earom-out $(OUT)/earom/earom.nv; \
	rec earom_readback_600 --frames 600 --script $$SC/earom_readback.txt --earom-in $(OUT)/earom/earom.nv; \
	for t in $$G/*.trc; do n=$$(basename $$t .trc); ref=""; \
	  [ $$n = attract_5000 ] && ref="--ref $(OUT)/refdumps/ref"; \
	  $(OUT)/gate $$t $$ref > $$G/$$n.gate.log; echo "$$n: $$(tail -1 $$G/$$n.gate.log)"; done; \
	echo "gate: all 12 traces PASS"

# ---- passcost: the oracle as a per-pass CPU-cost observer; refit app_loop.c's table --------
# Five scenarios (+ two_player, the M8 part 2 refit: 19,994 passes); the fitted rows should equal
# the table in app_loop.c.
passcost: $(OUT)/passcost
	@set -e; O=$(OUT)/passcost_out; SC=tests/scenarios; mkdir -p $$O; \
	$(OUT)/passcost --frames 5000 --no-dumps > $$O/pc_attract.txt; \
	for n in coin_start high_score superzapper fuseball_pulsar two_player; do \
	  $(OUT)/passcost --frames 3000 --no-dumps --script $$SC/$$n.txt > $$O/pc_$$n.txt; done; \
	python3 -I tools/fit_passcost.py $$O/pc_*.txt > $$O/fit.txt; \
	grep "^global" $$O/fit.txt; \
	grep "^    { 0x" $$O/fit.txt | while IFS= read -r row; do \
	  k=$$(echo "$$row" | sed 's|/\*.*||; s/ *$$//'); \
	  if grep -F -q -- "$$k" app_loop.c; then echo "MATCH   $$k"; else echo "DIFFER  $$k"; fi; done

# ---- avg: avgtime + avgframe over the oracle's attract dumps ----------------------------------
# The tools open literal Windows paths ("tests\ref\frame_NNNN.vram", "DIR\frame_NNNN.vram"): run from
# a scratch dir of symlinks with those names.  The reference check (tools/avg_ref.py frame, the
# disassembly's Python AVG model) needs disasm/_survey/roms_extracted/tempest3_cpu64k.bin, built from
# your own ROM set: python3 disasm/gen_from_roms.py "<dir or tempest.zip>" --image-only
avg: $(OUT)/avgtime $(OUT)/avgframe $(OUT)/refdumps/.stamp
	@set -e; A=$(OUT)/avg; R=$$A/run; rm -rf $$A; mkdir -p $$R $$A/py; \
	for f in $(OUT)/refdumps/ref/frame_*; do b=$$(basename $$f); \
	  ln -s ../../refdumps/ref/$$b "$$R/tests\\ref\\$$b"; ln -s ../../refdumps/ref/$$b "$$R/ref\\$$b"; done; \
	FR=$$(ls $(OUT)/refdumps/ref | sed -n 's/^frame_\(....\)\.vram$$/\1/p' | tr '\n' ' '); \
	(cd $$R && ../../avgtime ref | tail -1); \
	(cd $$R && ../../avgframe out $$FR > ../c.log); \
	echo "avgframe: $$(grep -c 'g walk same' $$A/c.log) of $$(echo $$FR | wc -w) frames: avg_walk == avg_run_frame"; \
	if [ -f ../disasm/_survey/roms_extracted/tempest3_cpu64k.bin ]; then \
	  trap 'rm -rf tests/ref' EXIT; [ ! -e tests/ref ] || { echo "tests/ref exists; refusing to overwrite"; exit 1; }; \
	  mkdir tests/ref; cp $(OUT)/refdumps/ref/frame_* $(OUT)/refdumps/ref/ref_index.json tests/ref/; \
	  python3 -I tools/avg_ref.py frame $$A/py $$FR > $$A/py.log; \
	  ok=0; for n in $$FR; do cmp -s "$$R/out\\frame_$$n.c.txt" $$A/py/frame_$$n.py.txt && ok=$$((ok+1)) || echo "DIFF frame $$n"; done; \
	  echo "avg_ref.py frame: $$ok of $$(echo $$FR | wc -w) frames byte-identical to the C walker"; \
	  [ $$ok = $$(echo $$FR | wc -w) ]; \
	else echo "skipped the Python-model comparison: no disasm/_survey/roms_extracted/tempest3_cpu64k.bin"; fi

# ---- Gate V: avgshapes vs tests/ref/avg_shapes_ref.txt (tools/avg_ref.py shapes) ---------------
# The reference is built from Atari's own source archive (github.com/historicalsource/tempest,
# unpacked to ../tempest-main/tempest-main/), which this repo does not ship.
gatev: $(OUT)/avgshapes
	@[ -f ../tempest-main/tempest-main/ALVROM.MAC ] || { echo "gatev: ../tempest-main/tempest-main/ALVROM.MAC not found (Atari's source archive); Gate V cannot be run"; exit 1; }
	@[ -f ../disasm/_survey/roms_extracted/tempest3_cpu64k.bin ] || { echo "gatev: build the 64K image first (see avg)"; exit 1; }
	@mkdir -p $(OUT)/avg && python3 -I tools/avg_ref.py shapes $(OUT)/avg/avg_shapes_ref.txt
	$(OUT)/avgshapes $(OUT)/avg/avg_shapes_ref.txt $(OUT)/avg/avg_shapes.html

check: skeleton selftest lockstep

clean:
	rm -rf $(OUT)

.PHONY: all mac app tools gate passcost avg gatev skeleton selftest lockstep check clean
